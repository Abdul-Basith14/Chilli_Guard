# ─────────────────────────────────────────────────────────────────────────────
# ChilliGuard — Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Backend ──────────────────────────────────────────────────────────────────
# Host & port for the FastAPI server
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Allowed frontend origin for CORS (comma-separated for multiple origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── ML / Data paths ──────────────────────────────────────────────────────────
# Absolute or relative path to your local dataset root
DATA_ROOT=./data

# Dataset I — Binary classification (Pure vs Adulterated)
DATASET_I_PATH=./data/dataset_I

# Dataset II — 19-class multi-label (future phase)
DATASET_II_PATH=./data/dataset_II

# Path where trained model weights will be saved / loaded from
MODEL_DIR=./ml/models

# Binary classifier weight file name (set after training Phase 1)
BINARY_MODEL_NAME=binary_classifier.pth

# 19-class classifier weight file name (set after training Phase 2)
MULTICLASS_MODEL_NAME=multiclass_classifier.pth

# ── Frontend ─────────────────────────────────────────────────────────────────
# Base URL the frontend uses to reach the backend API
# Do NOT prefix with REACT_ or expose secrets here.
VITE_API_BASE_URL=http://127.0.0.1:8000

# ── General ──────────────────────────────────────────────────────────────────
# Set to "development" or "production"
APP_ENV=development
